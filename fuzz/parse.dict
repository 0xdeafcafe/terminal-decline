# libFuzzer dictionary for the `parse` target: escape-sequence fragments.
# Use with: cargo +nightly fuzz run parse -- -dict=fuzz/parse.dict

# Introducers and terminators
esc="\x1b"
csi="\x1b["
osc="\x1b]"
dcs="\x1bP"
apc="\x1b_"
pm="\x1b^"
sos="\x1bX"
st="\x1b\\"
bel="\x07"
c1_csi="\xc2\x9b"
c1_st="\xc2\x9c"
can="\x18"
sub="\x1a"

# Fuzz-only commands (see fuzz/steps.rs)
cmd_resize="\xffR"
cmd_resize_tiny="\xffR\x00\x00"
cmd_resize_big="\xffR\xc7\x3b"
cmd_view_up="\xffV\x7f"
cmd_view_down="\xffV\x80"
cmd_select="\xffS"
cmd_clear="\xffC"
cmd_ambiguous="\xffA\x01"
cmd_pull_back="\xffP\x03"
cmd_limit_small="\xffL\x05"
cmd_limit_none="\xffL\x00"

# Private / intermediate markers and parameter bytes
p_q="\x1b[?"
p_gt="\x1b[>"
p_lt="\x1b[<"
p_eq="\x1b[="
p_bang="\x1b[!p"
sep=";"
sub_sep=":"
big_param="99999"
huge_param="4294967296"
zero="0"

# Cursor and editing
cup="\x1b[H"
cup_rc="\x1b[24;80H"
cuu="\x1b[A"
cud="\x1b[B"
cuf="\x1b[C"
cub="\x1b[D"
cnl="\x1b[E"
cpl="\x1b[F"
cha="\x1b[G"
vpa="\x1b[d"
hpa="\x1b[`"
ed="\x1b[J"
ed2="\x1b[2J"
ed3="\x1b[3J"
el="\x1b[K"
el1="\x1b[1K"
ech="\x1b[X"
ich="\x1b[@"
dch="\x1b[P"
il="\x1b[L"
dl="\x1b[M"
su="\x1b[S"
sd="\x1b[T"
rep="\x1b[b"
decstbm="\x1b[r"
decstbm_r="\x1b[5;10r"
decslrm="\x1b[s"
decsc="\x1b7"
decrc="\x1b8"
ind="\x1bD"
nel="\x1bE"
hts="\x1bH"
ri="\x1bM"
ris="\x1bc"
decaln="\x1b#8"
tbc="\x1b[3g"
cht="\x1b[I"
cbt="\x1b[Z"
decscusr="\x1b[5 q"

# Modes
alt1049="\x1b[?1049h"
alt1049l="\x1b[?1049l"
alt47="\x1b[?47h"
alt1047="\x1b[?1047h"
decom="\x1b[?6h"
decawm_off="\x1b[?7l"
decawm_on="\x1b[?7h"
dectcem="\x1b[?25l"
decckm="\x1b[?1h"
irm="\x1b[4h"
lnm="\x1b[20h"
mouse1000="\x1b[?1000h"
mouse1002="\x1b[?1002h"
mouse1003="\x1b[?1003h"
mouse1006="\x1b[?1006h"
paste="\x1b[?2004h"
focus="\x1b[?1004h"
sync_on="\x1b[?2026h"
sync_off="\x1b[?2026l"
decrqm="\x1b[?2026$p"
mode2027_off="\x1b[?2027l"
mode2027_on="\x1b[?2027h"
decrqm2027="\x1b[?2027$p"
kitty_push="\x1b[>1u"
kitty_pop="\x1b[<u"
kitty_query="\x1b[?u"
deckpam="\x1b="
deckpnm="\x1b>"

# SGR
sgr0="\x1b[m"
sgr_bold="\x1b[1m"
sgr_inv="\x1b[7m"
sgr_ul_curly="\x1b[4:3m"
sgr_fg256="\x1b[38;5;196m"
sgr_bg256="\x1b[48;5;22m"
sgr_fg_rgb="\x1b[38;2;255;128;0m"
sgr_bg_colon="\x1b[48:2::1:2:3m"
sgr_ul_color="\x1b[58;5;1m"
sgr_ul_color_rgb="\x1b[58:2::1:2:3m"
sgr_ul_color_off="\x1b[59m"
sgr_ul_double="\x1b[21m"
sgr_ul_dotted="\x1b[4:4m"
sgr_overline="\x1b[53m"
sgr_overline_off="\x1b[55m"
sgr_short="\x1b[38;5m"
sgr_bright="\x1b[97;104m"

# Queries
da1="\x1b[c"
da2="\x1b[>c"
dsr="\x1b[5n"
cpr="\x1b[6n"
xtwinops="\x1b[14t"
decrqss="\x1bP$qm\x1b\\"

# OSC
osc_title="\x1b]0;"
osc_title2="\x1b]2;"
osc_cwd="\x1b]7;file://h/tmp"
osc_link="\x1b]8;;http://x\x1b\\"
osc_link_end="\x1b]8;;\x1b\\"
osc_clip="\x1b]52;c;"
osc_fg_q="\x1b]10;?\x07"
osc_bg_q="\x1b]11;?\x07"
osc_palette="\x1b]4;1;rgb:ff/00/00\x07"

# Charsets
g0_dec="\x1b(0"
g0_ascii="\x1b(B"
g1_dec="\x1b)0"
so="\x0e"
si="\x0f"

# Text: wide, combining, joiners, invalid UTF-8
cjk="\xe6\xbc\xa2"
hangul="\xea\xb0\x80"
emoji="\xf0\x9f\x99\x82"
vs16="\xef\xb8\x8f"
zwj="\xe2\x80\x8d"
combining_acute="\xcc\x81"
flag_g="\xf0\x9f\x87\xac"
heart="\xe2\x9d\xa4"
vs15="\xef\xb8\x8e"
keycap="\xe2\x83\xa3"
keycap_1="1\xef\xb8\x8f\xe2\x83\xa3"
e_acute="e\xcc\x81"
skin_tone="\xf0\x9f\x8f\xbd"
thumbs_up="\xf0\x9f\x91\x8d"
flag_b="\xf0\x9f\x87\xa7"
virama="\xe0\xa5\x8d"
devanagari_ka="\xe0\xa4\x95"
arabic_number_sign="\xd8\x80"
hangul_jamo_v="\xe1\x85\xa1"
watch="\xe2\x8c\x9a"
section_ambiguous="\xc2\xa7"
box_ambiguous="\xe2\x94\x80"
pua_diacritic="\xf4\x8e\xbb\xae\xcc\x85"
rep_after_cluster="\x1b[5b"
