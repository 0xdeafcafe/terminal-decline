{
  "name": "terminal-decline-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run assets && astro dev --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs",
    "check": "astro check && tsc --noEmit",
    "build": "npm run assets && astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.4",
    "astro": "7.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
