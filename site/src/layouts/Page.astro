---
import Wordmark from '../components/Wordmark';
import '../styles/site.css';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://decline.forbes.red/images/social.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Terminal Decline. 26 MB at idle. Measured 2 November 2026 on an M1 Max." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="wrap top">
      <a href="/" aria-label="Terminal Decline, home"><Wordmark /></a>
      <div class="header-install-line">
        <code id="install-command">brew install --cask <span>0xdeafcafe/tap/terminal-decline</span></code>
        <button id="copy-install" class="copy-button" type="button" aria-label="Copy install command">Copy</button>
        <span id="copy-status" class="sr-only" role="status"></span>
      </div>
      <nav aria-label="Page">
        <a href="/#install">How to install</a>
        <a href="https://github.com/0xdeafcafe/terminal-decline">Source</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="wrap foot"><Wordmark /><p class="small muted">Alex Forbes-Reed. MIT licence.</p></footer>
    <script is:inline data-install-copy>
      (() => {
        const button = document.getElementById('copy-install');
        const command = document.getElementById('install-command');
        const status = document.getElementById('copy-status');
        let reset;
        button.addEventListener('click', async () => {
          clearTimeout(reset);
          try {
            await navigator.clipboard.writeText(command.textContent.trim());
            button.textContent = 'Copied';
            status.textContent = 'Install command copied.';
          } catch {
            button.textContent = 'Copy';
            const range = document.createRange();
            range.selectNodeContents(command);
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            status.textContent = 'Command selected. Press Command+C or Control+C to copy.';
          }
          reset = setTimeout(() => { button.textContent = 'Copy'; }, 2000);
        });
      })();
    </script>
  </body>
</html>
